SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-backend.azurewebsites.net

CORS_ALLOWED_ORIGINS=https://your-frontend.azurestaticapps.net
CSRF_TRUSTED_ORIGINS=https://your-frontend.azurestaticapps.net,https://your-backend.azurewebsites.net
SECURE_SSL_REDIRECT=True

# PostgreSQL connection
USE_POSTGRES=True
POSTGRES_DB=doctorappointment_db
POSTGRES_USER=doctorappointment_user
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=your-postgres.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# SSLCOMMERZ sandbox credentials from the merchant panel
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_IS_SANDBOX=True

# Must be reachable by the browser/gateway during local testing
SSLCOMMERZ_BACKEND_URL=https://your-backend.azurewebsites.net/
SSLCOMMERZ_FRONTEND_URL=https://your-frontend.azurestaticapps.net/

GEMINI_API_KEY=replace-with-a-server-side-api-key
GEMINI_MODEL=gemini-2.0-flash