SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL connection
POSTGRES_DB=doctorappointment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SSLCOMMERZ sandbox credentials from the merchant panel
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_IS_SANDBOX=True

# Must be reachable by the browser/gateway during local testing
SSLCOMMERZ_BACKEND_URL=http://127.0.0.1:8000/
SSLCOMMERZ_FRONTEND_URL=http://localhost:5173/

GEMINI_API_KEY=replace-with-a-server-side-api-key
GEMINI_MODEL=gemini-2.0-flash